# Copy to .env.local for local development. No value is required for sample mode.

# Public base URL used for canonical links, sitemap and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional in sample mode (a random per-process secret is used otherwise; quotes and
# order-access cookies then become invalid after a restart). REQUIRED (>= 32 chars) in production.
APP_SIGNING_SECRET=

# Set to "production" on the live deployment. Disables sample checkout and all dev tools.
# On Vercel, VERCEL_ENV=production has the same effect.
APP_ENV=

# Enable dev tools (/fejlesztes) when running a production build locally (`npm start`).
# Ignored when APP_ENV/VERCEL_ENV is production.
ENABLE_SAMPLE_DEV_TOOLS=

# Only a live production deployment with this set to "true" may be indexed.
ALLOW_INDEXING=

# ---- Future: Payload + Supabase (leave empty in sample mode) ----
# When both are set, /admin and /api are routed to Payload instead of the 503 page.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# PAYLOAD_SECRET=

# ---- Email delivery (server-only; never prefix these with NEXT_PUBLIC_) ----
# log    = render + log + development previews, nothing is sent (default)
# resend = send through Resend; RESEND_API_KEY, EMAIL_FROM and CONTACT_EMAIL are then required
EMAIL_MODE=log
# Resend API key (starts with re_). Put the real value only in .env.local or the Vercel dashboard.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Webshop <rendeles@yourdomain.hu>
EMAIL_FROM=
# Receives new-order and contact-form notifications (the visitor's address is only Reply-To)
CONTACT_EMAIL=
