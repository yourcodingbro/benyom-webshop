# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# All variables are server-side only. Never add a NEXT_PUBLIC_ prefix to any of them except
# NEXT_PUBLIC_SITE_URL (startup fails if a secret is given a NEXT_PUBLIC_ name).
# Validated centrally in src/config/env.ts; missing or invalid values stop the app with a clear message.

# ---- Environment ----
# development | test | preview | production. Required. Development tools (/fejlesztes) exist only
# when APP_ENV is valid and not "production"; a missing or invalid value hides them.
APP_ENV=development

# Public base URL for canonical links, sitemap and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only a production deployment with this set to "true" may be indexed by search engines.
ALLOW_INDEXING=

# ---- Database: Supabase PostgreSQL through Payload ----
# Runtime connection. On Vercel: Supabase "Shared pooler – Transaction mode" (port 6543), copied from
# the Connect dialog. The shared-pooler user is postgres.<project-ref>.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Migrations and the initial import (long-lived sessions): direct connection (IPv6, port 5432) or the
# shared pooler in session mode (IPv4, port 5432). Falls back to DATABASE_URL when empty.
# DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_MIGRATION_URL=
# Connections per server instance (1–20, default 5). Keep it low on serverless.
DATABASE_POOL_MAX=

# ---- Secrets (at least 32 random characters each; e.g. `openssl rand -hex 32`) ----
# Payload admin sessions.
PAYLOAD_SECRET=
# HMAC for cart quotes, order-access cookies and price-change decision tokens. Rotating it
# invalidates outstanding decision links and quotes.
APP_SIGNING_SECRET=

# ---- Supabase Storage (product media, S3-compatible API) ----
# Required in production; optional elsewhere (uploads are then refused, never stored locally).
# Project URL (public image URLs are built from it): https://<project-ref>.supabase.co
SUPABASE_URL=
# Public bucket for product images (create it in Supabase → Storage).
SUPABASE_STORAGE_BUCKET=
# From Storage → S3 configuration: https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=
# Region shown on the S3 configuration page.
SUPABASE_S3_REGION=
# Storage → S3 access keys. These bypass RLS for all buckets: server only.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# ---- Scheduled processing ----
# Vercel cron sends "Authorization: Bearer <CRON_SECRET>" to /cron/process. Required in production.
CRON_SECRET=

# ---- Email ----
# log    = render, store in the email history and log metadata; nothing is sent and no customer
#          deadline starts (default; use for development)
# resend = send through Resend; RESEND_API_KEY, EMAIL_FROM and CONTACT_EMAIL are required
EMAIL_MODE=log
# Resend API key (starts with re_).
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Webshop <rendeles@yourdomain.hu>
EMAIL_FROM=
# Receives new-order and contact-form notifications (the visitor's address is only Reply-To).
CONTACT_EMAIL=
# Signing secret of the Resend webhook (whsec_…), endpoint https://<site>/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# ---- Tests only ----
# Disposable database whose name ends in _test; `npm test` drops and re-creates its public schema.
# TEST_DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5432/benyom_test
